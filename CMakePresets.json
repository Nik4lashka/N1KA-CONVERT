{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "windows-clang-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "windows-clang-debug",
            "inherits": "windows-clang-base",
            "displayName": "Windows x64 Clang Debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "windows-clang-release",
            "inherits": "windows-clang-base",
            "displayName": "Windows x64 Clang Release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
        { "name": "windows-clang-release", "configurePreset": "windows-clang-release" }
    ]
}